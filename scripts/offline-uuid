#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)) || [[ ! $1 =~ ^[A-Za-z0-9_]{1,16}$ ]]; then
  printf '%s\n' 'Usage: waylandcraft-offline-uuid MINECRAFT_USERNAME' >&2
  exit 2
fi

digest=$(printf 'OfflinePlayer:%s' "$1" | md5sum)
digest=${digest%% *}
variant=$(( (16#${digest:16:1} & 3) | 8 ))
printf -v variant '%x' "$variant"
digest="${digest:0:12}3${digest:13:3}${variant}${digest:17}"

printf '%s-%s-%s-%s-%s\n' \
  "${digest:0:8}" \
  "${digest:8:4}" \
  "${digest:12:4}" \
  "${digest:16:4}" \
  "${digest:20:12}"
